{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Solace hidden clothing fashion metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": { "minLength": 1, "maxLength": 160 },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "fashionValue", "styleTags", "paletteTags", "formality", "practicality", "statement"],
        "properties": {
          "slot": { "enum": ["shirt", "pants", "hat", "boots"] },
          "fashionValue": { "type": "integer", "minimum": 0, "maximum": 100 },
          "styleTags": { "$ref": "#/$defs/tags" },
          "paletteTags": { "$ref": "#/$defs/tags" },
          "formality": { "$ref": "#/$defs/scale" },
          "practicality": { "$ref": "#/$defs/scale" },
          "statement": { "$ref": "#/$defs/scale" }
        }
      }
    }
  },
  "$defs": {
    "scale": { "type": "integer", "minimum": 0, "maximum": 3 },
    "tags": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9-]+$" } }
  }
}
